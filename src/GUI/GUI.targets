<Project>
  <PropertyGroup>
    <_GuiSourceDirectory>$(MSBuildThisFileDirectory)</_GuiSourceDirectory>
    <_GuiRepositoryDirectory>$([MSBuild]::NormalizeDirectory('$(_GuiSourceDirectory)', '../..'))</_GuiRepositoryDirectory>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(_GuiRepositoryDirectory)artifacts</ArtifactsPath>
    <_GuiIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(_GuiRepositoryDirectory)', '$(ArtifactsPath)', 'obj', 'Il2CppInspector.GUI'))</_GuiIntermediateDirectory>
    <_GuiCargoDirectory>$(_GuiIntermediateDirectory)cargo</_GuiCargoDirectory>
    <_GuiBinDirectory>$([MSBuild]::NormalizeDirectory('$(_GuiRepositoryDirectory)', '$(ArtifactsPath)', 'bin', 'Il2CppInspector.GUI'))</_GuiBinDirectory>
    <_GuiArtifactsPivot>$(Configuration.ToLowerInvariant())</_GuiArtifactsPivot>
    <_GuiArtifactsPivot Condition="'$(RuntimeIdentifier)' != ''">$(_GuiArtifactsPivot)_$(RuntimeIdentifier)</_GuiArtifactsPivot>
    <_GuiOutputDirectory>$(_GuiBinDirectory)$(_GuiArtifactsPivot)/</_GuiOutputDirectory>
    <_GuiCargoProfile>dev</_GuiCargoProfile>
    <_GuiCargoOutput>debug</_GuiCargoOutput>
    <_GuiCargoProfile Condition="'$(Configuration)' == 'Release'">release</_GuiCargoProfile>
    <_GuiCargoOutput Condition="'$(Configuration)' == 'Release'">release</_GuiCargoOutput>
    <_GuiExecutable>il2cpp-inspector-gui</_GuiExecutable>
    <_GuiExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">il2cpp-inspector-gui.exe</_GuiExecutable>
  </PropertyGroup>

  <Target Name="DetectCargo">
    <Exec
      Command="cargo --version"
      EchoOff="true"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
    >
      <Output TaskParameter="ExitCode" PropertyName="_CargoExitCode" />
    </Exec>
    <Warning
      Condition="'$(_CargoExitCode)' != '0'"
      Text="cargo was not found or cannot run; skipping Il2CppInspector.GUI compilation. Install Rust from https://rustup.rs to build the GUI."
    />
  </Target>

  <!-- Publishing with NoBuild uses the GUI copied by an earlier build of the same configuration and RID. -->
  <Target Name="BuildGui" DependsOnTargets="DetectCargo" Condition="'$(NoBuild)' != 'true'">
    <Exec
      Condition="'$(_CargoExitCode)' == '0'"
      Command="cargo build --locked --quiet --profile $(_GuiCargoProfile) --target-dir &quot;$(_GuiCargoDirectory)&quot;"
      WorkingDirectory="$(_GuiSourceDirectory)"
      IgnoreStandardErrorWarningFormat="true"
      StandardErrorImportance="high"
    />
    <Copy
      Condition="'$(_CargoExitCode)' == '0'"
      SourceFiles="$(_GuiCargoDirectory)/$(_GuiCargoOutput)/$(_GuiExecutable)"
      DestinationFolder="$(_GuiOutputDirectory)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target Name="PublishGui" AfterTargets="Publish" DependsOnTargets="BuildGui" Condition="'$(MSBuildProjectName)' == 'Il2CppInspector.CLI'">
    <Copy
      Condition="'$(NoBuild)' == 'true' or '$(_CargoExitCode)' == '0'"
      SourceFiles="$(_GuiOutputDirectory)$(_GuiExecutable)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
    />
  </Target>

  <Target
    Name="CleanGui"
    AfterTargets="Clean"
    DependsOnTargets="DetectCargo"
    Condition="Exists('$(_GuiIntermediateDirectory)') or Exists('$(_GuiBinDirectory)')"
  >
    <!-- Cargo refuses unmarked directories; incomplete output is still removed below. -->
    <Exec
      Condition="'$(_CargoExitCode)' == '0' and Exists('$(_GuiCargoDirectory)/CACHEDIR.TAG')"
      Command="cargo clean --target-dir &quot;$(_GuiCargoDirectory)&quot;"
      WorkingDirectory="$(_GuiSourceDirectory)"
      IgnoreStandardErrorWarningFormat="true"
    />
    <RemoveDir Directories="$(_GuiBinDirectory);$(_GuiIntermediateDirectory)" />
  </Target>
</Project>
