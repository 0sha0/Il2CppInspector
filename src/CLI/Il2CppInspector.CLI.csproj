<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPublishable>true</IsPublishable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Il2CppInspector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Common/Il2CppInspector.Common/Il2CppInspector.Common.csproj" />
    <GamePluginProjects Include="../Plugins/*/*.csproj" />
    <ProjectReference Include="@(GamePluginProjects)" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../GUI/GUI.targets" />
  <Target Name="PreparePublishBundle" BeforeTargets="PrepareForPublish">
    <PropertyGroup>
      <_PublishArtifactsRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(ArtifactsPath)'))</_PublishArtifactsRoot>
      <_PublishBundleDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_PublishBundleDirectory>
    </PropertyGroup>
    <!-- Publishing replaces the bundle, including files left by a different configuration or the old project layout. -->
    <RemoveDir
      Directories="$(_PublishBundleDirectory)"
      Condition="$([System.String]::Copy('$(_PublishBundleDirectory)').StartsWith('$(_PublishArtifactsRoot)', System.StringComparison.OrdinalIgnoreCase)) and '$(_PublishBundleDirectory)' != '$(_PublishArtifactsRoot)'"
    />
  </Target>
  <Target Name="CollectGamePluginFiles">
    <!-- SDK project references build these class libraries without the executable's RID or self-contained settings. -->
    <MSBuild
      Projects="@(GamePluginProjects)"
      Targets="GetGamePluginOutput"
      Properties="Configuration=$(Configuration)"
      RemoveProperties="RuntimeIdentifier;SelfContained"
      BuildInParallel="true"
    >
      <Output TaskParameter="TargetOutputs" ItemName="_GamePluginFiles" />
    </MSBuild>
    <ItemGroup>
      <!-- The host already supplies Common and its dependencies through the default load context. -->
      <_GamePluginFiles Remove="@(ReferenceCopyLocalPaths)" MatchOnMetadata="Filename;Extension" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_GamePluginFiles)">
      <Output TaskParameter="Filtered" ItemName="GamePluginFiles" />
    </RemoveDuplicates>
    <ItemGroup>
      <LegacyGamePluginFiles Include="@(GamePluginFiles)" Condition="'%(GamePluginFiles.LegacyPluginDirectory)' != ''" />
    </ItemGroup>
  </Target>
  <Target Name="CopyGamePlugins" AfterTargets="Build" DependsOnTargets="CollectGamePluginFiles">
    <!-- Remove the previous per-game layout only for plugins built by this project. -->
    <RemoveDir Directories="@(LegacyGamePluginFiles->'$(OutDir)plugins/%(LegacyPluginDirectory)')" />
    <Copy SourceFiles="@(GamePluginFiles)" DestinationFiles="@(GamePluginFiles->'$(OutDir)%(PackagePath)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishGamePlugins" AfterTargets="Publish" DependsOnTargets="CollectGamePluginFiles">
    <RemoveDir Directories="@(LegacyGamePluginFiles->'$(PublishDir)plugins/%(LegacyPluginDirectory)')" />
    <Copy SourceFiles="@(GamePluginFiles)" DestinationFiles="@(GamePluginFiles->'$(PublishDir)%(PackagePath)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
